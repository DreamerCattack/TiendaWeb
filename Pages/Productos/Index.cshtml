@page
@using TiendaWeb.Pages.Productos
@model TiendaWeb.Pages.Productos.IndexModel

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Nuevo producto</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Producto[0].Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Producto[0].Precio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Producto[0].FechaRegistro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Producto[0].Stock)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Producto)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Precio)
                </td>
                <td>
                    @Html.DisplayFor(model => item.FechaRegistro)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Stock)
                </td>
                <td>
                    <a asp-page="./Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning">Editar</a>

                    <a asp-page="./Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-info">Detalles</a>

                    <a asp-page="./Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

